# คัดลอกไฟล์นี้เป็น .env แล้วแทนที่ค่าทุกตัวก่อนใช้งานจริง (ค่าใน .env ห้าม commit
# เข้า git — ดู .gitignore)

# --- Postgres ---
# ใช้โดย postgres image เองตอน initialize (สร้าง user/db แรกเริ่ม)
POSTGRES_USER=loguser
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=logplatform

# ใช้โดย Vector (postgres sink) และ backend/worker ต่อไป
# ต้องตรงกับ 3 ค่าด้านบนเป๊ะ — ไม่ได้คำนวณอัตโนมัติให้
POSTGRES_URL=postgres://loguser:changeme_dev_password@postgres:5432/logplatform

# --- Backend auth ---
# secret คนละตัวสำหรับ access token กับ refresh token โดยตั้งใจ (ดูเหตุผลใน
# backend/src/auth/tokens.ts) สร้างค่าจริงด้วย:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex_random_value
JWT_REFRESH_SECRET=replace_with_a_different_64_char_hex_random_value

# --- SaaS mode only (docker-compose.saas.yml) ---
# ไม่ต้องตั้งถ้ารันแค่ appliance (docker-compose.yml เฉยๆ) — Caddyfile.saas
# อ่าน 2 ค่านี้ผ่าน {$SAAS_DOMAIN} / {$SAAS_ACME_EMAIL}
#
# ต้องมี DNS A/AAAA record ของโดเมนนี้ชี้มาที่ IP ของ cloud VM แล้วจริงๆ
# ก่อนรัน docker compose -f docker-compose.yml -f docker-compose.saas.yml up
# ไม่งั้น Let's Encrypt ตรวจ ownership ผ่าน HTTP-01 challenge ไม่ผ่าน
SAAS_DOMAIN=log.example.com
# Let's Encrypt ใช้อีเมลนี้แจ้งเตือนถ้า certificate ใกล้หมดอายุแล้วต่ออายุ
# อัตโนมัติไม่สำเร็จ (เช่น DNS หลุด) ไม่ใช่ข้อมูลที่แสดงต่อผู้ใช้ระบบ
SAAS_ACME_EMAIL=you@example.com

# --- Email alert channel (worker/src/channels/email.ts) ---
# default ชี้ไปที่ Mailhog (service "mailhog" ใน docker-compose.yml) — ดักอีเมล
# ทุกฉบับไว้ดูที่ http://localhost:8025 แทนการส่งออกไปจริง ไม่ต้องมี SMTP
# account จริงตอน dev/เดโม
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=alerts@log-platform.local
# ปล่อยว่างไว้เมื่อใช้ Mailhog (ไม่เช็ค auth) — ตอน production เปลี่ยนไปใช้ SMTP
# provider จริง (Gmail app password, SendGrid, ฯลฯ) แล้วค่อยเติม 2 ค่านี้
SMTP_USER=
SMTP_PASS=
